{
  "name": "dsh-compaction-adaptive",
  "version": "0.2.0",
  "private": false,
  "description": "Adaptive context compaction for DeepSeek Harness: derives each model's pressure threshold and retained tail from its context window and the session's measured growth.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtomYuan/dsh-compaction-adaptive.git"
  },
  "homepage": "https://github.com/ArtomYuan/dsh-compaction-adaptive#readme",
  "bugs": {
    "url": "https://github.com/ArtomYuan/dsh-compaction-adaptive/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./insight-host": "./insight-host.js",
    "./client": "./client.js",
    "./policy": "./lib/policy.js",
    "./chunking": "./lib/chunking.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "insight-host.js",
    "client.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "compaction",
    "context"
  ],
  "license": "MIT",
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
